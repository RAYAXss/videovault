# Générer avec : python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_IN_PRODUCTION

# SQLite (dev) ou PostgreSQL (prod)
DATABASE_URL=sqlite+aiosqlite:///./videovault.db

# URL du frontend (CORS)
FRONTEND_URL=http://localhost:5173

# Debug (active Swagger + logs SQL)
DEBUG=true

# Dossier de stockage des fichiers chiffrés
VAULT_DIR=vault

# Taille max upload en Mo
MAX_UPLOAD_SIZE_MB=4096

# Itérations PBKDF2 (min 600000 en prod)
PBKDF2_ITERATIONS=600000

# Durée des tokens
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
